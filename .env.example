ADMIN_SECRET=infocs-change-this-secret

# 배포(Vercel 등)에서 사이트 등록을 저장하려면 아래 중 하나:
# 1) Vercel → Storage → Blob 생성 (BLOB_READ_WRITE_TOKEN 자동 설정)
#    Blob이 Private이면 BLOB_ACCESS는 비워 두세요. Public 스토어면 public
# BLOB_ACCESS=private
# 2) Upstash Redis
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 홈 전환: temporary = 임시 회사소개, original = 기존 메인
# NEXT_PUBLIC_HOME_MODE=temporary
# NEXT_PUBLIC_HOME_MODE=original
